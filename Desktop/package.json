    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
